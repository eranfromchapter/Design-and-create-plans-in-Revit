<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Revit-facing add-in. COMPILE-ONLY in CI (Rule 5): the Nice3point packages ship
       the real Revit 2025 API assemblies as compile-time references; live execution is the
       human phase-gate checklist in docs/MANUAL_REVIT_TEST.md. Pinned exact versions
       (amendment revit-7); plan the TFM bump for Autodesk's in-service .NET 10 migration.
       It carries NO tests — all pure logic lives in ChapterHub.Core. -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2025.4.60" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2025.4.60" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../ChapterHub.Core/ChapterHub.Core.csproj" />
  </ItemGroup>

</Project>
