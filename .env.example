# Never commit real values (Part J). See PLAN.md Part I.
DATABASE_URL=postgres://chapter:chapter@localhost:5432/revit_agent
ANTHROPIC_API_KEY=            # brief-extractor, layout-compiler
LLM_MODEL_EXTRACTOR=claude-sonnet-5   # pin; upgrade deliberately
LLM_MODEL_COMPILER=claude-opus-5      # layout generation is the hardest spatial-reasoning call
ENVELOPE_MASTER_KEY=          # dev only; encrypts per-project Ed25519 seeds at rest (AES-256-GCM); Key Vault in prod
BLOB_CONNECTION_STRING=       # Azure Blob (exports, renders, clouds)
AIDM_ENDPOINT=                # existing AIDM service (read by services/aidm-bridge); empty = deterministic mock renderer
AIDM_API_KEY=                 # bearer for AIDM_ENDPOINT (aidm-bridge); unused when the endpoint is empty
RUN_LIVE_LLM=0
AUTO_APPROVE=0                # 1 only in CI e2e — approval gates are real in every other context
SCAN_CONVERTER_URL=           # Lane A converter (Phase 2); scan routes 503 when unset
BRIEF_EXTRACTOR_URL=          # brief extractor (Phase 3); transcript routes 503 when unset
LAYOUT_COMPILER_URL=          # layout compiler (Phase 4); compile-layout routes 503 when unset
AIDM_BRIDGE_URL=              # aidm-bridge (Phase 7); compose-render / finish-selection routes 503 when unset
BLOB_DIR=                     # gateway content-addressed blob root (exports, control maps, renders); blob routes 503 when unset — Azure Blob (BLOB_CONNECTION_STRING) lands in Phase 10
LLM_MODE=fixture              # LLM services: fixture (CI/e2e replay) | live (needs ANTHROPIC_API_KEY)
