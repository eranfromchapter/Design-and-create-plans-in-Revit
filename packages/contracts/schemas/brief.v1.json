{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hub.chapter.internal/schemas/brief-1.json",
  "title": "ClientBrief",
  "description": "Structured client brief extracted from session transcripts. No defaults are materialized by this schema; per-field defaults live in code.",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "rooms_required", "adjacency_rules", "style_tags"],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "brief_version", "source_sessions"],
      "properties": {
        "project_id": { "type": "string", "format": "uuid" },
        "brief_version": { "type": "integer", "minimum": 1 },
        "source_sessions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "confirmed_by_client": {
          "type": "boolean",
          "description": "the layout-compiler refuses briefs where this is not true"
        }
      }
    },
    "rooms_required": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["program", "count"],
        "properties": {
          "program": {
            "enum": ["kitchen", "bathroom", "powder", "bedroom", "living", "dining", "laundry", "closet", "corridor", "office", "other"]
          },
          "count": { "type": "integer", "minimum": 1, "maximum": 8 },
          "notes": { "type": "string", "maxLength": 500 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "adjacency_rules": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["a", "b", "relation"],
        "properties": {
          "a": { "type": "string", "minLength": 1 },
          "b": { "type": "string", "minLength": 1 },
          "relation": { "enum": ["open_to", "adjacent", "near", "not_adjacent"] },
          "hard": { "type": "boolean" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "style_tags": {
      "type": "array",
      "maxItems": 12,
      "items": { "type": "string", "minLength": 1, "maxLength": 40 }
    },
    "finish_tier": { "enum": ["economy", "standard", "premium", "luxury"] },
    "keep_items": {
      "type": "array",
      "maxItems": 20,
      "items": { "type": "string", "maxLength": 200 }
    },
    "special_constraints": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "kind"],
        "properties": {
          "text": { "type": "string", "maxLength": 300 },
          "kind": { "enum": ["accessibility", "budget", "schedule", "building_rule", "other"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "open_questions": {
      "type": "array",
      "maxItems": 15,
      "items": { "type": "string", "maxLength": 300 }
    },
    "contradictions": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "earlier", "later", "resolution"],
        "properties": {
          "field": { "type": "string", "minLength": 1 },
          "earlier": { "type": "string", "maxLength": 300 },
          "later": { "type": "string", "maxLength": 300 },
          "resolution": { "enum": ["latest_wins", "needs_client"] }
        }
      }
    }
  }
}
